+"""The decode candidate scheme of SM12x (GB10 / RTX Blackwell): DeepGEMM paged fp4
+logits over the index-K pool, a bool mask of the source's best blocks, and the
+consumers' logits masked by it before the paged top-k.
+
+This is the dsv4.1 branch's ``TorchCandidateIndexer`` (f80c91a4b), which SM12x ran
+because DeepGEMM's paged *sparse* MQA logits (``sparse_table``) are SM100-only while
+its dense paged fp4 logits run on SM12x. ``dense_blocks`` is the Hopper scheme: a
+Triton scorer plus torch gathers and top-k over the full capture-sized width on
+every candidate layer, which costs SM12x decode about a third above the candidate
+window. Prefill is unaffected and stays on ``dense_blocks``."""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Iterator, Optional, Tuple
+
+import msgspec
+import torch
+import torch.nn.functional as F
+
+from sglang.kernels.ops.attention.dsv4.index_logits import (
+    deep_gemm_fp4_paged_mqa_logits,
+)
+from sglang.srt.layers.attention.dsv4.indexer import topk_transform_paged_from_metadata
+
+from .scoring import DeepGEMMDecodeData, get_deep_gemm_decode_data
+from .types import CandidateMetadata, DecodeInputs, Selection
+
+if TYPE_CHECKING:
+    from sglang.srt.layers.attention.dsv4.metadata import PagedIndexerMetadata
+    from sglang.srt.mem_cache.deepseek_v4_memory_pool import DeepSeekV4TokenToKVPool
+
+
+class CandidateMask(CandidateMetadata, msgspec.Struct):
+    # [rows, width] bool over compressed positions: the published blocks
+    mask: torch.Tensor
+
+
+def _rows(t: Optional[torch.Tensor], rows: Optional[slice]) -> Optional[torch.Tensor]:
+    return t if t is None or rows is None else t[rows]
+
+
+def _select_candidate_blocks(
+    logits: torch.Tensor,
+    compress_lens: torch.Tensor,
+    topk_blocks: int,
+    block_size: int,
+) -> torch.Tensor:
+    """Torch reference of the source's mask (f80c91a4b ``select_candidate_blocks``):
+    the ``topk_blocks`` best blocks per row, the newest one always kept; positions
+    past a row's length must already be ``-inf``."""
+    width = logits.size(-1)
+    scores = F.pad(logits, (0, -width % block_size), value=-torch.inf)
+    scores = scores.unflatten(-1, (-1, block_size)).amax(dim=-1)
+    num_blocks = scores.size(-1)
+    last = (compress_lens - 1) // block_size
+    scores = scores.masked_fill(
+        torch.arange(num_blocks, device=logits.device) == last, torch.inf
+    )
+    top = scores.topk(min(topk_blocks, num_blocks), dim=-1)
+    keep = torch.zeros_like(scores, dtype=torch.bool).scatter_(
+        -1, top.indices, top.values > -torch.inf
+    )
+    return keep.repeat_interleave(block_size, dim=-1)[..., :width]
+
+
+def _two_level_decode_logits(
+    logits: torch.Tensor,
+    seq_lens: torch.Tensor,
+    *,
+    is_candidate_source: bool,
+    topk_blocks: int,
+    block_size: int,
+    published: Optional[torch.Tensor],
+) -> Tuple[torch.Tensor, Optional[torch.Tensor]]:
+    """f80c91a4b ``two_level_decode_logits`` for a source or a consumer: the logits
+    with the unread tail (and, for a consumer, the unpublished blocks) at ``-inf``,
+    plus the source's mask. Graph-captured; no host sync."""
+    if (
+        logits.is_cuda
+        and torch.version.cuda is not None
+        and logits.ndim == 2
+        and logits.stride(1) == 1
+        and seq_lens.device == logits.device
+        and seq_lens.dtype in (torch.int32, torch.int64)
+        and seq_lens.is_contiguous()
