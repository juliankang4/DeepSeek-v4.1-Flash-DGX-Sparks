+"""Long prefill chunks on GB10 TP4/TP8: each attention-TP rank scores its slice of
+the chunk's query rows with the DeepGEMM prefill indexer, and the int32 picks (and
+a source's block ids) are all-gathered. No floating-point value crosses ranks.
+
+Port of the SG18 split (SPARK_PREFILL_TP_SPLIT) that the dsv4.1-branch image ran
+inside its chunked dense indexer; the gates and the row partition are unchanged."""
+
+from __future__ import annotations
+
+import functools
+import logging
+import os
+from typing import Any, List, Optional, Tuple
+
+import torch
+
+from .scoring import DeepGEMMPrefillData
+
+logger = logging.getLogger(__name__)
+
+_PARTITION_TILE = 128
+
+
+class RowSplit:
+    def __init__(self, group: Any, min_context: int, min_rows: int) -> None:
+        self.group = group
+        self.rank = group.rank_in_group
+        self.world = group.world_size
+        self.min_context = min_context
+        self.min_rows = min_rows
+
+    def eligible(self, data: DeepGEMMPrefillData) -> bool:
+        # Shape-only, so every rank of the group decides the same way.
+        return (
+            data.num_rows >= self.min_rows
+            and max(data.lens_per_request, default=0) >= self.min_context
+            and data.q_fp4.is_cuda
+            and not torch.cuda.is_current_stream_capturing()
+        )
+
+    def partition(self, rows: int) -> Tuple[int, int, int]:
+        """``(start, end, extent)`` of this rank's rows; every rank gathers
+        ``extent`` rows, the last ones padded."""
+        tile = _PARTITION_TILE
+        extent = -(-rows // (self.world * tile)) * tile
+        start = self.rank * extent
+        return start, min(rows, start + extent), extent
+
+    @staticmethod
+    def local(data: DeepGEMMPrefillData, start: int, end: int) -> DeepGEMMPrefillData:
+        """Rows ``[start, end)`` of ``data``; flattened K and request widths stay
+        whole, so the selections are the same flattened-K columns."""
+        rows_per_request: List[int] = []
+        offset = 0
+        for n in data.rows_per_request:
+            rows_per_request.append(max(0, min(offset + n, end) - max(offset, start)))
+            offset += n
+        rows = slice(start, max(start, end))
+        return DeepGEMMPrefillData(
+            k_slots=data.k_slots,
+            request_starts=data.request_starts[rows],
+            lens_per_request=data.lens_per_request,
+            rows_per_request=rows_per_request,
+            compress_lens=data.compress_lens[rows],
+            q_fp4=data.q_fp4[rows],
+            q_sf=data.q_sf[rows],
+            weights=data.weights[rows],
+        )
+
+    def gather(self, local: torch.Tensor, extent: int, rows: int) -> torch.Tensor:
+        """``[rows, cols]`` int32 from every rank's ``local`` ``[<= extent, cols]``."""
+        packed = local.new_full((extent, local.shape[1]), -1)
+        packed[: local.shape[0]] = local
+        return self.group.all_gather(packed, dim=0)[:rows]
+
+
+@functools.cache
+def make_row_split(is_draft: bool) -> Optional[RowSplit]:
+    """None unless ``SPARK_PREFILL_TP_SPLIT=1`` on a GB10 attention-TP group of 4 or
+    8 ranks (no CP / DP attention / DCP), for the target model only."""
+    if is_draft or os.environ.get("SPARK_PREFILL_TP_SPLIT", "0").strip() != "1":
+        return None
+    from sglang.srt.runtime_context import get_parallel
+
+    parallel = get_parallel()
+    group = parallel.attn_tp_group
+    settings = (
+        os.environ.get("SPARK_PREFILL_TP_SPLIT", "0").strip(),
+        os.environ.get("SPARK_PREFILL_TP_MIN_CONTEXT", "32768").strip(),
+        os.environ.get("SPARK_PREFILL_TP_MIN_ROWS", "1024").strip(),
+    )
+    agreed = group.all_gather_object(settings)
+    if any(s != settings for s in agreed):
+        raise RuntimeError(f"inconsistent SPARK_PREFILL_TP_* settings over TP: {agreed}")
+    min_context, min_rows = int(settings[1]), int(settings[2])
+    if min_context < 32768 or min_rows < 1024:
+        raise ValueError(f"SPARK_PREFILL_TP_MIN_CONTEXT/ROWS below 32768/1024: {settings}")
+    topology = (
+        group.world_size in (4, 8)
+        and parallel.attn_cp_size == 1
+        and parallel.attn_dp_size == 1
+        and getattr(parallel, "attn_dcp_size", 1) == 1
+    )
+    hardware = torch.cuda.is_available() and torch.cuda.get_device_capability() == (
+        12,
+        1,
+    )
+    enabled = topology and hardware
+    logger.info(
+        "DSV41 prefill indexer TP split: enabled=%s rank=%s world=%s "
+        "min_context=%s min_rows=%s",
+        enabled,
+        group.rank_in_group,
+        group.world_size,
+        min_context,
+        min_rows,
+    )
+    return RowSplit(group, min_context, min_rows) if enabled else None
